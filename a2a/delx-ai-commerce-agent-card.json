      "examples": [
        "npx agentcash@latest fetch https://api.delx.ai/api/v1/x402/page-extract -m POST -b '{\"url\":\"https://example.com\"}' --payment-protocol x402 --payment-network base --max-amount 0.02"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ]
    },
    {
